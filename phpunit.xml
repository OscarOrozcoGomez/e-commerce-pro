<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <!-- Los tests del grupo ai_deepseek solo prueban aiParseDeepSeekResponse() con respuestas
         fabricadas (nunca llaman a la red real ni gastan tokens), pero generan advertencias
         ruidosas via error_log() en la salida. Se excluyen por defecto; para correrlos usa el
         flag "group ai_deepseek" (dos guiones) de phpunit cuando se trabaje en Alex/el
         asistente de IA. -->
    <groups>
        <exclude>
            <group>ai_deepseek</group>
        </exclude>
    </groups>

    <php>
        <env name="APP_ENV" value="qa"/>
        <env name="DISABLE_GSM" value="1"/>
        <env name="ALLOW_GSM_LOCAL" value="0"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_NAME" value="test_db"/>
        <env name="DB_USER" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_CHARSET" value="utf8mb4"/>
        <!-- El OCR de caducidades nunca debe salir a la red en pruebas unitarias;
             los tests que ejercitan la interpretacion inyectan su propio callable. -->
        <env name="LOTE_OCR_ENABLED" value="0"/>
    </php>
</phpunit>
