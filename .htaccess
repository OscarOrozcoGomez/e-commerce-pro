# Impedir que el servidor muestre la lista de archivos en cualquier carpeta
Options -Indexes

# Cache de navegador para imagenes/CSS/JS estaticos: sin esto, el navegador re-descarga
# cada imagen del catalogo en cada visita/recarga (nunca la guarda), lo que hace que el
# catalogo se sienta lento sobre todo en repaso/paginacion. Envuelto en <IfModule> para
# no tronar si el modulo no esta cargado en algun entorno.
# Algunas imagenes de producto se suben en AVIF; sin este AddType Apache las
# sirve como application/octet-stream y ciertos navegadores no las pintan.
<IfModule mod_mime.c>
    AddType image/avif .avif
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png|webp|avif|gif|svg)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Redirecciones de error personalizadas
ErrorDocument 403 /views/error.php
ErrorDocument 404 /views/error.php
ErrorDocument 500 /views/error.php

# Google Secret Manager (sin token temporal)
# La llave de la service account vive FUERA de public_html (mejor: el navegador
# nunca puede servirla). La ruta anterior apuntaba dentro de public_html y no
# existia, asi que Apache no autenticaba con GSM y NINGUN secreto de Secret
# Manager cargaba (FB_PAGE_ID / FB_PAGE_ACCESS_TOKEN / PII_ENCRYPTION_KEY / Maps_KEY
# quedaban vacios; DB_USER/DB_PASSWORD/TELEGRAM sobrevivian por un archivo de
# respaldo en el host).
SetEnv GCP_PROJECT_ID vendimia-497305
SetEnv GCP_SA_KEY_FILE /home/beautyandwell/.gcp/sa.json
